DATABASE_URL="file:./dev.db"
# 필수(기본값 없음, 비어 있으면 기동 실패). 긴 무작위 문자열을 직접 만들어 넣는다
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
PORT=6015

# (선택) 브라우저가 다른 출처에서 API를 호출할 때. 미설정 시 운영 도메인·로컬 관리자/Swagger 허용
# CORS_ORIGINS=https://reservation.dmu.gosky.kr,http://localhost:5173

# 관리자 웹(admin-ui) 로그인 전용 (이메일 없이 비밀번호만)
# 필수(기본값 없음, 비어 있으면 기동 실패)
ADMIN_PANEL_PASSWORD=""

# MCP 브릿지(src/mcp/reservation-mcp.ts)가 REST를 호출할 때 (로컬 개발: http://127.0.0.1:6015/api/v1)
RESERVATION_API_BASE_URL="https://reservation.dmu.gosky.kr/api/v1"
# 로그인 후 발급 accessToken을 넣으면 매번 인자로 넘기지 않아도 됨
RESERVATION_JWT=""
RESERVATION_ADMIN_JWT=""
