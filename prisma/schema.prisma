generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OperationStatus {
  OPEN
  CLOSED
  BREAK_TIME
  HOLIDAY
  INSPECTION
}

enum CongestionLevel {
  LOW
  NORMAL
  BUSY
  VERY_BUSY
}

enum ReservationStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  phone        String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reservations Reservation[]
  apiKeys      ApiKey[]
  adminLogs    AdminActionLog[]
}

model ApiKey {
  id         Int      @id @default(autoincrement())
  userId     Int
  name       String
  keyPrefix  String   @unique
  keyHash    String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Hospital {
  id                Int      @id @default(autoincrement())
  name              String
  region            String
  address           String
  phone             String
  description       String   @default("")
  openTime          String
  closeTime         String
  // 점심시간(둘 다 있거나 둘 다 없음, HH:mm) - 이 구간과 겹치는 30분 칸은 예약을 받지 않는다(2026-10-28)
  breakStart        String?
  breakEnd          String?
  // 휴진 요일: 쉼표로 구분한 요일 번호(0=일 … 6=토), 빈 문자열이면 없음
  closedWeekdays    String   @default("")
  bookingAvailable  Boolean  @default(true)
  deleted           Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  departments HospitalDepartment[]
  status      HospitalStatus?
  reservations Reservation[]
}

model HospitalDepartment {
  id             Int      @id @default(autoincrement())
  hospitalId     Int
  departmentName String
  active         Boolean  @default(true)
  hospital       Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
}

model HospitalStatus {
  id                      Int               @id @default(autoincrement())
  hospitalId              Int               @unique
  operationStatus         OperationStatus   @default(OPEN)
  congestionLevel         CongestionLevel   @default(NORMAL)
  waitingCount            Int               @default(0)
  averageWaitingMinutes   Int               @default(0)
  todayReservationCount   Int               @default(0)
  acceptingPatients       Boolean           @default(true)
  notice                  String            @default("")
  updatedAt               DateTime          @updatedAt
  hospital                Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
}

// 주의: 활성(BOOKED·CONFIRMED) 예약의 부분 유니크 인덱스 2개(Reservation_active_user_slot_key,
// Reservation_active_hospital_dept_slot_key)는 마이그레이션 20261022120000·20261027120000 의 SQL 로만 존재한다(Prisma 가 부분 인덱스를 표현하지 못함).
// 시간 칸은 (병원, 진료과, 날짜, 시간)마다 한 건이다(20261027120000 이 병원 단위 인덱스를 교체).
// `prisma migrate dev` 가 이 인덱스를 드리프트로 보고 지우려 하면 거부할 것.
model Reservation {
  id               Int               @id @default(autoincrement())
  hospitalId       Int
  userId           Int
  patientName      String
  phone            String
  birthDate        DateTime?
  department       String
  reservationDate  DateTime
  reservationTime  String
  symptomSummary   String            @default("")
  memo             String            @default("")
  status           ReservationStatus @default(BOOKED)
  guardianName     String?
  guardianPhone    String?
  urgencyLevel     String?
  symptomSeverity  Int?
  emergencyFlag    Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([hospitalId, reservationDate, reservationTime])
  @@index([userId, reservationDate, reservationTime])
}

model AdminActionLog {
  id          Int      @id @default(autoincrement())
  adminUserId Int
  targetType  String
  targetId    Int
  actionType  String
  beforeValue String   @default("{}")
  afterValue  String   @default("{}")
  createdAt   DateTime @default(now())

  admin User @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([targetType, targetId])
}
